# CaliGym — required environment variables (Vercel + local)
# Public (safe for the browser):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER prefix with NEXT_PUBLIC_, NEVER commit real values):
# Used only by /api/auth/resolve-username for secure username -> email resolution
# and by scripts/seed.ts for admin provisioning.
# Must be set in Vercel -> Project -> Settings -> Environment Variables for the
# Production environment (Preview/Development alone is not enough) or username
# login fails in production with "Username login is not configured on the server".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI Coach (used by /api/chat). Server-only — do NOT use a NEXT_PUBLIC_ prefix.
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# DeepSeek AI Coach (used by /api/ai/deepseek). Server-only.
# Get yours at https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenCode AI Coach (used by /api/ai/opencode). Server-only.
# Get yours at https://opencode.ai/api-keys
OPENCODE_API_KEY=your_opencode_api_key

# Optional base URL overrides for DeepSeek and OpenCode (defaults are provided):
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENCODE_BASE_URL=https://api.opencode.ai/v1

# Seed/backfill script only (local use, never deploy):
# SEED_ADMIN_PASSWORD=choose-a-strong-password

# Supabase Auth URL configuration (Supabase dashboard -> Authentication -> URL Configuration):
#   Site URL: https://caligym329.vercel.app
#   Additional Redirect URLs:
#     https://caligym329.vercel.app/auth/callback
#     https://caligym329.vercel.app/reset-password
#     http://localhost:3000/auth/callback
#     http://localhost:3000/reset-password